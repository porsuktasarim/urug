<%- include('../partials/header', { title: 'Site Ayarları', t }) %>

  <div style="max-width: 480px;">
    <h1 class="h4 mb-4">Site Ayarları</h1>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <p class="text-muted small">
      Site adı ve sloganı, genel görsel temada (yakında) ve bazı işlevsel
      yerlerde (ör. Google Drive yükleme klasörü adı) kullanılır.
    </p>

    <form method="POST">
      <div class="mb-3">
        <label class="form-label">Site Adı</label>
        <input type="text" name="siteName" class="form-control" required
               value="<%= config && config.siteName ? config.siteName : 'Uruğ' %>">
      </div>
      <div class="mb-4">
        <label class="form-label">Slogan <span class="text-muted small">(opsiyonel)</span></label>
        <input type="text" name="tagline" class="form-control"
               value="<%= config && config.tagline ? config.tagline : '' %>"
               placeholder="ör: Köyümüzün Hafızası">
      </div>
      <button type="submit" class="btn btn-primary"><%= t('common.actions.save') %></button>
    </form>
  </div>

  <a href="/ayarlar" class="d-inline-block mt-3">&larr; Ayarlar</a>

<%- include('../partials/footer', { t }) %>
