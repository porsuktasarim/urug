<%- include('../partials/header', { title: 'Google Drive', t }) %>

  <div style="max-width: 560px;">
    <h1 class="h4 mb-4">Google Drive Bağlantıları</h1>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <h2 class="h6 text-muted">1. OAuth İstemci Kimliği</h2>
    <p class="text-muted small">
      Google Cloud Console'dan alınan bilgiler — artık <code>.env</code> dosyasına
      gerek yok, buradan girebilirsin.
      <% if (hasEnvCredentials && !(oauthCredentials && oauthCredentials.clientId)) { %>
        (Şu an <code>.env</code>'deki değerler kullanılıyor, aşağıya girersen onun yerine bunlar geçerli olur.)
      <% } %>
    </p>
    <form action="/ayarlar/drive/kimlik-bilgileri" method="POST" class="border rounded p-3 mb-4">
      <div class="mb-2">
        <label class="form-label small">Client ID</label>
        <input type="text" name="clientId" class="form-control form-control-sm" required
               value="<%= oauthCredentials && oauthCredentials.clientId ? oauthCredentials.clientId : '' %>">
      </div>
      <div class="mb-2">
        <label class="form-label small">Client Secret <span class="text-muted">(zaten girilmişse boş bırakırsan değişmez)</span></label>
        <input type="password" name="clientSecret" class="form-control form-control-sm"
               placeholder="<%= oauthCredentials && oauthCredentials.clientSecretEncrypted ? '••••••••' : '' %>">
      </div>
      <div class="mb-2">
        <label class="form-label small">Yönlendirme Adresi (Redirect URI)</label>
        <input type="text" name="redirectUri" class="form-control form-control-sm" required
               placeholder="https://siten.com/ayarlar/drive/callback"
               value="<%= oauthCredentials && oauthCredentials.redirectUri ? oauthCredentials.redirectUri : '' %>">
        <div class="form-text">Google Cloud Console'da "Authorized redirect URIs" listesine BİREBİR aynısını eklemelisin.</div>
      </div>
      <button type="submit" class="btn btn-sm btn-primary">Kaydet</button>
    </form>

    <h2 class="h6 text-muted">2. Bağlı Hesaplar</h2>
    <p class="text-muted small">
      Birden fazla hesap bağlayabilirsin. Görsel yüklemeleri her zaman
      <strong>birincil</strong> işaretli TEK bir hesaba gider. Yedekleme
      için birden fazla hesap aynı anda işaretlenebilir (yedeklilik için).
    </p>

    <% if (connections.length === 0) { %>
      <p class="text-muted small">Henüz hiç hesap bağlanmadı.</p>
    <% } else { %>
      <div class="list-group mb-3">
        <% connections.forEach(function (conn) { %>
          <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <strong><%= conn.label %></strong>
                <% if (conn.driveAccountEmail) { %><span class="text-muted small ms-1">(<%= conn.driveAccountEmail %>)</span><% } %>
                <% if (conn.isPrimaryForImages) { %>
                  <span class="badge bg-success ms-1">Görseller için birincil</span>
                <% } %>
                <% if (conn.useForBackups) { %>
                  <span class="badge bg-info text-dark ms-1">Yedeklemede kullanılıyor</span>
                <% } %>
              </div>
              <form action="/ayarlar/drive/<%= conn._id %>/baglantiyi-kes" method="POST"
                    onsubmit="return confirm('Bu bağlantıyı kesmek istediğine emin misin?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Bağlantıyı Kes</button>
              </form>
            </div>
            <div class="d-flex gap-2 mt-2">
              <% if (!conn.isPrimaryForImages) { %>
                <form action="/ayarlar/drive/<%= conn._id %>/birincil-yap" method="POST">
                  <button type="submit" class="btn btn-sm btn-outline-secondary">Görseller İçin Birincil Yap</button>
                </form>
              <% } %>
              <form action="/ayarlar/drive/<%= conn._id %>/yedek-kullanimi" method="POST" class="d-flex align-items-center gap-1">
                <input type="checkbox" name="useForBackups" class="form-check-input" id="backup_<%= conn._id %>"
                       <%= conn.useForBackups ? 'checked' : '' %> onchange="this.form.submit()">
                <label class="form-check-label small" for="backup_<%= conn._id %>">Yedeklemede kullan</label>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <a href="/ayarlar/drive/baglan" class="btn btn-primary">+ Yeni Hesap Bağla</a>
  </div>

  <a href="/ayarlar" class="d-inline-block mt-3">&larr; Ayarlar</a>

<%- include('../partials/footer', { t }) %>
