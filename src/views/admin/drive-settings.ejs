<%- include('../partials/header', { title: 'Google Drive', t }) %>

  <div style="max-width: 480px;">
    <h1 class="h4 mb-4">Google Drive Bağlantısı</h1>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <p class="text-muted small">
      Google Drive'a bağlanabilirsin — bağlanmak, hemen kullanılmaya başlanacağı
      anlamına gelmez. Bağlandıktan sonra aşağıdan neyin Drive'a gideceğini
      ayrı ayrı seçebilirsin (sadece görseller, sadece yedekler, ikisi de,
      ya da hiçbiri — ileride lazım olursa diye bağlı bırakabilirsin).
    </p>

    <% if (config && config.connected) { %>
      <div class="alert alert-success">
        <strong>Bağlı</strong><br>
        <% if (config.driveAccountEmail) { %>Hesap: <%= config.driveAccountEmail %><br><% } %>
        <% if (config.connectedByUsername) { %>Bağlayan: <%= config.connectedByUsername %><% } %>
      </div>

      <form action="/ayarlar/drive/kullanim-ayarlari" method="POST" class="border rounded p-3 mb-3">
        <label class="form-label fw-semibold">Ne için kullanılsın?</label>
        <div class="form-check mb-2">
          <input type="checkbox" name="useForImages" class="form-check-input" id="useForImages"
                 <%= config.useForImages ? 'checked' : '' %>>
          <label class="form-check-label" for="useForImages">
            Fotoğraf yüklemeleri (aile/kişi görselleri Drive'a gitsin)
          </label>
        </div>
        <div class="form-check mb-2">
          <input type="checkbox" name="useForBackups" class="form-check-input" id="useForBackups"
                 <%= config.useForBackups ? 'checked' : '' %>>
          <label class="form-check-label" for="useForBackups">
            Yedekleme <span class="text-muted small">(yedekleme sistemi henüz kurulmadı — bu ayar hazır bekliyor)</span>
          </label>
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Kaydet</button>
      </form>

      <form action="/ayarlar/drive/baglantiyi-kes" method="POST"
            onsubmit="return confirm('Bağlantıyı kesersen yeni yüklemeler tekrar yerel diske yapılır. Emin misin?');">
        <button type="submit" class="btn btn-outline-danger">Bağlantıyı Kes</button>
      </form>
    <% } else { %>
      <div class="alert alert-secondary">Şu an bağlı değil — fotoğraflar yerel diske yükleniyor.</div>
      <a href="/ayarlar/drive/baglan" class="btn btn-primary">Google Drive'a Bağlan</a>
    <% } %>

    <hr class="my-4">
    <p class="text-muted small">
      Bağlantı için önce <code>.env</code> / Coolify ortam değişkenlerinde
      <code>GOOGLE_CLIENT_ID</code>, <code>GOOGLE_CLIENT_SECRET</code>,
      <code>GOOGLE_REDIRECT_URI</code> tanımlı olmalı (Google Cloud Console'dan
      OAuth istemci kimliği oluşturularak alınır).
    </p>
  </div>

  <a href="/ayarlar" class="d-inline-block mt-3">&larr; Ayarlar</a>

<%- include('../partials/footer', { t }) %>
