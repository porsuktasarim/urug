<%- include('../partials/header', { title: t('family.title'), t }) %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><%= t('family.title') %></h1>
    <a href="/aileler/new" class="btn btn-primary"><%= t('common.actions.new') %></a>
  </div>

  <% if (familyGroups.length === 0) { %>
    <p class="text-muted"><%= t('common.status.empty') %></p>
  <% } else { %>
    <div class="list-group">
      <% familyGroups.forEach(function (fg) { %>
        <div class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <% if (fg.colorCode) { %>
              <span class="d-inline-block rounded-circle me-1" style="width:12px;height:12px;background-color:<%= fg.colorCode %>;"></span>
            <% } %>
            <strong><%= fg.name %></strong>
            <span class="text-muted ms-2">/<%= fg.slug %></span>
            <% if (!fg.colorCode) { %>
              <span class="badge bg-light text-muted border ms-1">renk atanmamış</span>
            <% } %>
          </div>
          <div class="d-flex gap-2">
            <a href="/<%= fg.slug %>" class="btn btn-sm btn-outline-primary">
              Görüntüle
            </a>
            <a href="/aileler/<%= fg._id %>/duzenle" class="btn btn-sm btn-outline-secondary">
              <%= t('common.actions.edit') %>
            </a>
            <form action="/aileler/<%= fg._id %>/sil" method="POST"
                  onsubmit="return confirm('<%= t('common.confirm.delete') %>');">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <%= t('common.actions.delete') %>
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

<%- include('../partials/footer', { t }) %>
