<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('family.title') %> — <%= t('common.appName') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 mb-0"><%= t('family.title') %></h1>
      <a href="/aileler/new" class="btn btn-primary"><%= t('common.actions.new') %></a>
    </div>

    <% if (familyGroups.length === 0) { %>
      <p class="text-muted"><%= t('common.status.empty') %></p>
    <% } else { %>
      <div class="list-group">
        <% familyGroups.forEach(function (fg) { %>
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <strong><%= fg.name %></strong>
              <span class="text-muted ms-2">/<%= fg.slug %></span>
            </div>
            <div class="d-flex gap-2">
              <a href="/aileler/<%= fg._id %>/duzenle" class="btn btn-sm btn-outline-secondary">
                <%= t('common.actions.edit') %>
              </a>
              <form action="/aileler/<%= fg._id %>/sil" method="POST"
                    onsubmit="return confirm('<%= t('common.confirm.delete') %>');">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <%= t('common.actions.delete') %>
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>
