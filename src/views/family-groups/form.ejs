<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= familyGroup && familyGroup._id ? t('family.editTitle') : t('family.newTitle') %> — <%= t('common.appName') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-4" style="max-width: 480px;">
    <h1 class="h4 mb-4">
      <%= familyGroup && familyGroup._id ? t('family.editTitle') : t('family.newTitle') %>
    </h1>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <form method="POST"
          action="<%= familyGroup && familyGroup._id ? '/aileler/' + familyGroup._id : '/aileler' %>">
      <div class="mb-3">
        <label class="form-label"><%= t('family.fields.name') %></label>
        <input type="text" name="name" class="form-control" required
               value="<%= familyGroup ? familyGroup.name : '' %>">
      </div>

      <div class="mb-3">
        <label class="form-label"><%= t('family.fields.slug') %></label>
        <input type="text" name="slug" class="form-control"
               value="<%= familyGroup ? familyGroup.slug : '' %>">
        <div class="form-text"><%= t('family.slugHint') %></div>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><%= t('common.actions.save') %></button>
        <a href="/aileler" class="btn btn-outline-secondary"><%= t('common.actions.cancel') %></a>
      </div>
    </form>
  </div>
</body>
</html>
