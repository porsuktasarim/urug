<%- include('../partials/header', { title: familyGroup && familyGroup._id ? t('family.editTitle') : t('family.newTitle'), t }) %>

  <div style="max-width: 480px;">
    <h1 class="h4 mb-4">
      <%= familyGroup && familyGroup._id ? t('family.editTitle') : t('family.newTitle') %>
    </h1>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <form method="POST"
          action="<%= familyGroup && familyGroup._id ? '/aileler/' + familyGroup._id : '/aileler' %>">
      <div class="mb-3">
        <label class="form-label"><%= t('family.fields.name') %></label>
        <input type="text" name="name" class="form-control" required
               value="<%= familyGroup ? familyGroup.name : '' %>">
      </div>

      <div class="mb-3">
        <label class="form-label"><%= t('family.fields.slug') %></label>
        <input type="text" name="slug" class="form-control"
               value="<%= familyGroup ? familyGroup.slug : '' %>">
        <div class="form-text"><%= t('family.slugHint') %></div>
      </div>

      <div class="mb-3">
        <label class="form-label">Renk <span class="text-muted small">(ağaç görselinde bu aileyi temsil eder)</span></label>
        <div class="d-flex align-items-center gap-2">
          <input type="color" name="colorCode" id="colorCodeInput" class="form-control form-control-color"
                 value="<%= familyGroup && familyGroup.colorCode ? familyGroup.colorCode : suggestedColor %>">
          <span class="text-muted small">Seçmezsen otomatik önerilen renk kullanılır.</span>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Aile Hikayesi / Açıklaması <span class="text-muted small">(opsiyonel, herkese açık aile sayfasında görünür)</span></label>
        <textarea name="description" class="form-control" rows="5"><%= familyGroup && familyGroup.description ? familyGroup.description : '' %></textarea>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><%= t('common.actions.save') %></button>
        <a href="/aileler" class="btn btn-outline-secondary"><%= t('common.actions.cancel') %></a>
      </div>
    </form>

    <% if (familyGroup && familyGroup._id) { %>
      <hr class="my-4">
      <h2 class="h6 text-muted">Fotoğraflar</h2>

      <% if (familyGroup.photos && familyGroup.photos.length > 0) { %>
        <div class="d-flex flex-wrap gap-3 mb-3">
          <% familyGroup.photos.forEach(function (photo) { %>
            <div style="width: 160px;">
              <img src="<%= photo.url %>" alt="<%= photo.caption || '' %>" class="img-fluid rounded border mb-1" style="height:100px;width:160px;object-fit:cover; cursor:pointer;"
                   onclick="document.getElementById('editPhoto_<%= photo._id %>').classList.toggle('d-none');">
              <% if (photo.caption) { %>
                <div class="small text-muted"><%= photo.caption %></div>
              <% } %>
              <% if (photo.tags && photo.tags.length > 0) { %>
                <div class="mb-1">
                  <% photo.tags.forEach(function (tag) { %>
                    <span class="badge bg-light text-muted border" style="font-size:0.65rem;"><%= tag %></span>
                  <% }); %>
                </div>
              <% } %>
              <div class="d-flex gap-1 mb-1">
                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill"
                        onclick="document.getElementById('editPhoto_<%= photo._id %>').classList.toggle('d-none');">
                  Düzenle
                </button>
                <form action="/aileler/<%= familyGroup._id %>/foto-sil/<%= photo._id %>" method="POST" class="flex-fill"
                      onsubmit="return confirm('<%= t('common.confirm.delete') %>');">
                  <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sil</button>
                </form>
              </div>

              <form id="editPhoto_<%= photo._id %>" action="/aileler/<%= familyGroup._id %>/foto-duzenle/<%= photo._id %>" method="POST" class="d-none border rounded p-2 mb-1">
                <input type="text" name="caption" class="form-control form-control-sm mb-1" placeholder="Açıklama" value="<%= photo.caption || '' %>">
                <input type="text" name="tags" class="form-control form-control-sm mb-1" placeholder="Etiketler (virgülle)" value="<%= photo.tags ? photo.tags.join(', ') : '' %>">
                <button type="submit" class="btn btn-sm btn-primary w-100">Kaydet</button>
              </form>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-muted small">Henüz fotoğraf eklenmedi.</p>
      <% } %>

      <form action="/aileler/<%= familyGroup._id %>/foto-ekle" method="POST" enctype="multipart/form-data" class="border rounded p-3" style="max-width: 400px;">
        <div class="mb-2">
          <label class="form-label small">Yeni Fotoğraf</label>
          <input type="file" name="photo" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp,image/gif" required>
        </div>
        <div class="mb-2">
          <label class="form-label small">Açıklama <span class="text-muted">(opsiyonel)</span></label>
          <input type="text" name="caption" class="form-control form-control-sm">
        </div>
        <div class="mb-2">
          <label class="form-label small">Etiketler <span class="text-muted">(virgülle ayırın, opsiyonel)</span></label>
          <input type="text" name="tags" class="form-control form-control-sm" placeholder="ör: düğün, 1980ler">
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Yükle</button>
      </form>
    <% } %>
  </div>

<%- include('../partials/footer', { t }) %>
