<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %><%= t('common.appName') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

  <header>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/"><%= t('common.appName') %></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto align-items-md-center">
            <li class="nav-item">
              <a class="nav-link" href="/aileler"><%= t('family.title') %></a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/kisiler"><%= t('person.title') %></a>
            </li>
            <% if (typeof isGlobalAdmin !== 'undefined' && isGlobalAdmin) { %>
              <li class="nav-item">
                <a class="nav-link" href="/admin/ozellikler"><%= t('attribute.title') %></a>
              </li>
            <% } %>
            <% if (typeof currentUsername !== 'undefined' && currentUsername) { %>
              <li class="nav-item text-light small me-2">
                <%= currentUsername %>
              </li>
              <li class="nav-item">
                <form action="/cikis" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-sm btn-outline-light">Çıkış Yap</button>
                </form>
              </li>
            <% } else { %>
              <li class="nav-item">
                <a class="btn btn-sm btn-outline-light" href="/giris">Giriş Yap</a>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <main class="container py-4 flex-grow-1">
