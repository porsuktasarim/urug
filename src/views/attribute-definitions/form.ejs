<%- include('../partials/header', { title: attribute && attribute._id ? t('attribute.editTitle') : t('attribute.newTitle'), t }) %>

  <div style="max-width: 560px;">
    <h1 class="h4 mb-4">
      <%= attribute && attribute._id ? t('attribute.editTitle') : t('attribute.newTitle') %>
    </h1>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <% var isSystem = attribute && attribute.isSystem; %>
    <% if (isSystem) { %>
      <div class="alert alert-secondary"><%= t('attribute.systemLocked') %></div>
    <% } %>

    <form method="POST"
          action="<%= attribute && attribute._id ? '/admin/ozellikler/' + attribute._id : '/admin/ozellikler' %>">

      <div class="mb-3">
        <label class="form-label"><%= t('attribute.fields.key') %></label>
        <input type="text" name="key" class="form-control"
               value="<%= attribute ? attribute.key : '' %>"
               <%= isSystem ? 'readonly' : 'required' %>>
        <div class="form-text"><%= t('attribute.keyHint') %></div>
      </div>

      <div class="mb-3">
        <label class="form-label"><%= t('attribute.fields.label') %></label>
        <input type="text" name="label" class="form-control" required
               value="<%= attribute ? attribute.label : '' %>">
      </div>

      <div class="mb-3">
        <label class="form-label"><%= t('attribute.fields.type') %></label>
        <select name="type" class="form-select" <%= isSystem ? 'disabled' : '' %>>
          <% types.forEach(function (type) { %>
            <option value="<%= type %>" <%= attribute && attribute.type === type ? 'selected' : '' %>>
              <%= t('attribute.types.' + type) %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label"><%= t('attribute.fields.options') %></label>
        <input type="text" name="options" class="form-control"
               value="<%= attribute && attribute.options ? attribute.options.join(', ') : '' %>"
               <%= isSystem ? 'disabled' : '' %>
               placeholder="örn: melez, yerli, kültür">
      </div>

      <div class="row">
        <div class="col-6 mb-3">
          <label class="form-label"><%= t('attribute.fields.group') %></label>
          <input type="text" name="group" class="form-control"
                 value="<%= attribute ? attribute.group : 'Genel' %>">
        </div>
        <div class="col-6 mb-3">
          <label class="form-label"><%= t('attribute.fields.order') %></label>
          <input type="number" name="order" class="form-control"
                 value="<%= attribute ? attribute.order : 0 %>">
        </div>
      </div>

      <div class="form-check mb-2">
        <input type="checkbox" name="isRequired" class="form-check-input" id="isRequired"
               <%= attribute && attribute.isRequired ? 'checked' : '' %>
               <%= isSystem ? 'disabled' : '' %>>
        <label class="form-check-label" for="isRequired"><%= t('attribute.fields.isRequired') %></label>
      </div>

      <div class="form-check mb-3">
        <input type="checkbox" name="isActive" class="form-check-input" id="isActive"
               <%= !attribute || attribute.isActive ? 'checked' : '' %>
               <%= isSystem ? 'disabled' : '' %>>
        <label class="form-check-label" for="isActive"><%= t('attribute.fields.isActive') %></label>
      </div>

      <fieldset class="border rounded p-3 mb-3" <%= isSystem ? 'disabled' : '' %>>
        <legend class="h6">Koşullu Zorunluluk (opsiyonel)</legend>
        <div class="mb-2">
          <label class="form-label"><%= t('attribute.fields.dependsOn') %></label>
          <input type="text" name="dependsOn" class="form-control"
                 value="<%= attribute && attribute.conditionalRequirement ? attribute.conditionalRequirement.dependsOn || '' : '' %>"
                 placeholder="örn: hasNoLastName">
        </div>
        <div>
          <label class="form-label"><%= t('attribute.fields.requiredWhen') %></label>
          <select name="requiredWhen" class="form-select">
            <option value="true">true</option>
            <option value="false">false</option>
          </select>
        </div>
      </fieldset>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><%= t('common.actions.save') %></button>
        <a href="/admin/ozellikler" class="btn btn-outline-secondary"><%= t('common.actions.cancel') %></a>
      </div>
    </form>
  </div>

<%- include('../partials/footer', { t }) %>
