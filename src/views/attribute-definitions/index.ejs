<%- include('../partials/header', { title: t('attribute.title'), t }) %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><%= t('attribute.title') %></h1>
    <a href="/admin/ozellikler/new" class="btn btn-primary"><%= t('common.actions.new') %></a>
  </div>

  <% if (attributes.length === 0) { %>
    <p class="text-muted"><%= t('common.status.empty') %></p>
  <% } else { %>
    <p class="text-muted small">
      Bu liste, kişi formundaki (ve ileride diğer formlardaki) gerçek alan sırasını gösterir.
      Yukarı/aşağı ile kolayca yeniden sıralayabilirsin — istersen "Düzenle"den sayı olarak da girebilirsin.
    </p>
    <% var currentGroup = null; %>
    <% attributes.forEach(function (attr, index) { %>
      <% if (attr.group !== currentGroup) { %>
        <% currentGroup = attr.group; %>
        <h2 class="h6 text-muted mt-4"><%= currentGroup %></h2>
      <% } %>
      <div class="list-group-item list-group d-flex justify-content-between align-items-center mb-2 p-3 bg-white rounded border">
        <div class="d-flex align-items-center gap-2">
          <div class="d-flex flex-column">
            <form action="/admin/ozellikler/<%= attr._id %>/yukari" method="POST">
              <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-1"
                      <%= index === 0 ? 'disabled' : '' %> title="Yukarı taşı">&uarr;</button>
            </form>
            <form action="/admin/ozellikler/<%= attr._id %>/asagi" method="POST">
              <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-1 mt-1"
                      <%= index === attributes.length - 1 ? 'disabled' : '' %> title="Aşağı taşı">&darr;</button>
            </form>
          </div>
          <div>
            <strong><%= attr.label %></strong>
            <span class="text-muted ms-2">(<%= attr.key %> · <%= t('attribute.types.' + attr.type) %>)</span>
            <% if (attr.isSystem) { %>
              <span class="badge bg-secondary ms-2">sistem</span>
            <% } %>
            <% if (attr.isRequired) { %>
              <span class="badge bg-danger ms-1">zorunlu</span>
            <% } %>
            <% if (!attr.isActive) { %>
              <span class="badge bg-warning text-dark ms-1">pasif</span>
            <% } %>
          </div>
        </div>
        <div class="d-flex gap-2">
          <% if (!attr.isSystem) { %>
            <form action="/admin/ozellikler/<%= attr._id %>/aktiflik" method="POST">
              <button type="submit" class="btn btn-sm btn-outline-secondary">
                <%= attr.isActive ? 'Pasifleştir' : 'Aktifleştir' %>
              </button>
            </form>
          <% } %>
          <a href="/admin/ozellikler/<%= attr._id %>/duzenle" class="btn btn-sm btn-outline-secondary">
            <%= t('common.actions.edit') %>
          </a>
          <% if (!attr.isSystem) { %>
            <form action="/admin/ozellikler/<%= attr._id %>/sil" method="POST"
                  onsubmit="return confirm('<%= t('common.confirm.delete') %>');">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <%= t('common.actions.delete') %>
              </button>
            </form>
          <% } %>
        </div>
      </div>
    <% }); %>
  <% } %>

<%- include('../partials/footer', { t }) %>
