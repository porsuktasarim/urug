<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('person.title') %> — <%= t('common.appName') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 mb-0"><%= t('person.title') %></h1>
      <a href="/kisiler/new" class="btn btn-primary"><%= t('common.actions.new') %></a>
    </div>

    <% if (persons.length === 0) { %>
      <p class="text-muted"><%= t('common.status.empty') %></p>
    <% } else { %>
      <div class="list-group">
        <% persons.forEach(function (p) { %>
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <strong><%= displayName(p) %></strong>
              <span class="text-muted ms-2">
                <%= p.familyGroupId ? p.familyGroupId.name : '—' %>
              </span>
              <% if (p.hasNoLastName) { %>
                <span class="badge bg-secondary ms-1">soyadı yok</span>
              <% } %>
            </div>
            <div class="d-flex gap-2">
              <a href="/kisiler/<%= p._id %>/duzenle" class="btn btn-sm btn-outline-secondary">
                <%= t('common.actions.edit') %>
              </a>
              <form action="/kisiler/<%= p._id %>/sil" method="POST"
                    onsubmit="return confirm('<%= t('common.confirm.delete') %>');">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <%= t('common.actions.delete') %>
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <a href="/" class="d-inline-block mt-3">&larr; Ana Sayfa</a>
  </div>
</body>
</html>
