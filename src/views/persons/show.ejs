<%- include('../partials/header', { title: displayName(person), t }) %>

  <div style="max-width: 480px;">
    <h1 class="h3 mb-0">
      <%= displayName(person) %>
      <% personalNicknames.forEach(function (nick, i) { %>
        <span class="fst-italic text-muted h5">"<%= nick %>"<%= i < personalNicknames.length - 1 ? ',' : '' %></span>
      <% }); %>
    </h1>
    <% if (familyLakab) { %>
      <div class="mb-1">
        <span class="badge rounded-pill text-bg-light border text-muted"><%= familyLakab.value %></span>
      </div>
    <% } %>
    <p class="text-muted">
      <%= person.familyGroupId ? person.familyGroupId.name : 'Aile bilgisi yok' %>
      <% if (person.birthYear) { %> · <%= person.birthYear %><% } %><% if (person.deathYear) { %> - <%= person.deathYear %><% } %>
    </p>

    <h2 class="h6 text-muted mt-4">Üst Soy</h2>
    <div class="mb-1">
      <strong>Baba:</strong>
      <% if (father) { %>
        <% var fatherUrl = personProfileUrl(father); %>
        <% if (fatherUrl) { %>
          <a href="<%= fatherUrl %>"><%= displayName(father) %></a>
        <% } else { %>
          <%= displayName(father) %>
        <% } %>
      <% } else { %>
        <span class="text-muted">bilinmiyor</span>
      <% } %>
    </div>
    <div class="mb-3">
      <strong>Anne:</strong>
      <% if (mother) { %>
        <% var motherUrl = personProfileUrl(mother); %>
        <% if (motherUrl) { %>
          <a href="<%= motherUrl %>"><%= displayName(mother) %></a>
        <% } else { %>
          <%= displayName(mother) %>
        <% } %>
      <% } else { %>
        <span class="text-muted">bilinmiyor</span>
      <% } %>
    </div>

    <h2 class="h6 text-muted mt-4">Kardeşler</h2>
    <% if (siblings.length > 0) { %>
      <ul>
        <% siblings.forEach(function (sib) { %>
          <% var sibUrl = personProfileUrl(sib); %>
          <li>
            <% if (sibUrl) { %>
              <a href="<%= sibUrl %>"><%= displayName(sib) %></a>
            <% } else { %>
              <%= displayName(sib) %>
            <% } %>
            <% if (sib.birthYear) { %><span class="text-muted small"> (<%= sib.birthYear %>)</span><% } %>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="text-muted">Kayıtlı kardeş yok.</p>
    <% } %>

    <h2 class="h6 text-muted mt-4">Eş</h2>
    <% if (spouses.length > 0) { %>
      <ul>
        <% spouses.forEach(function (spouse) { %>
          <% var spouseUrl = personProfileUrl(spouse); %>
          <li>
            <% if (spouseUrl) { %>
              <a href="<%= spouseUrl %>"><%= displayName(spouse) %></a>
            <% } else { %>
              <%= displayName(spouse) %>
            <% } %>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="text-muted">Kayıtlı eş yok.</p>
    <% } %>

    <h2 class="h6 text-muted mt-4">Alt Soy</h2>
    <% if (children.length > 0) { %>
      <ul>
        <% children.forEach(function (child) { %>
          <% var childUrl = personProfileUrl(child); %>
          <% var relLabel = childRelationLabel(child); %>
          <li>
            <% if (childUrl) { %>
              <a href="<%= childUrl %>"><%= displayName(child) %></a>
            <% } else { %>
              <%= displayName(child) %>
            <% } %>
            <% if (relLabel) { %><span class="text-muted small"> (<%= relLabel %>)</span><% } %>
            <% if (child.birthYear) { %><span class="text-muted small"> · <%= child.birthYear %></span><% } %>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="text-muted">Kayıtlı çocuk yok.</p>
    <% } %>

    <a href="/kisiler/<%= person._id %>/duzenle" class="btn btn-outline-secondary btn-sm mt-2">
      <%= t('common.actions.edit') %>
    </a>
  </div>

<%- include('../partials/footer', { t }) %>
