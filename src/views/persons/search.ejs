<%- include('../partials/header', { title: 'Kişi Ara', t }) %>

  <div style="max-width: 560px;">
    <h1 class="h4 mb-1">Kişi Ara</h1>
    <p class="text-muted small mb-4">
      Ad-soyad yazmaya başla, en az 2 karakterden sonra sonuçlar otomatik gelir.
      Aynı ad-soyad'lı kişileri ayırt etmek için doğum yılı ve aile bilgisi de gösterilir.
    </p>

    <input type="text" id="searchInput" class="form-control form-control-lg mb-3"
           placeholder="örn. Hüseyin Türkeli" autocomplete="off">

    <div id="searchResults"></div>
    <div id="searchEmpty" class="text-muted" style="display: none;">Sonuç bulunamadı.</div>
    <div id="searchHint" class="text-muted small">En az 2 karakter yazmaya başla.</div>
  </div>

  <script>
    (function () {
      var input = document.getElementById('searchInput');
      var results = document.getElementById('searchResults');
      var emptyMsg = document.getElementById('searchEmpty');
      var hintMsg = document.getElementById('searchHint');
      var debounceTimer = null;

      function renderResults(list) {
        results.innerHTML = '';

        if (list.length === 0) {
          emptyMsg.style.display = 'block';
          return;
        }
        emptyMsg.style.display = 'none';

        list.forEach(function (p) {
          var card = document.createElement('div');
          card.className = 'list-group-item d-flex justify-content-between align-items-center';

          var left = document.createElement('div');
          var nameLine = document.createElement('strong');
          nameLine.textContent = p.displayName;
          left.appendChild(nameLine);

          var metaLine = document.createElement('div');
          metaLine.className = 'text-muted small';
          var metaParts = [];
          if (p.familyGroupName) metaParts.push(p.familyGroupName);
          if (p.birthYear) metaParts.push(p.birthYear);
          if (p.eldestChildName) metaParts.push('en büyük çocuğu: ' + p.eldestChildName);
          metaLine.textContent = metaParts.join(' · ');
          left.appendChild(metaLine);

          card.appendChild(left);

          if (p.familyGroupSlug && p.slug) {
            var link = document.createElement('a');
            link.href = '/' + p.familyGroupSlug + '/' + p.slug;
            link.className = 'btn btn-sm btn-outline-secondary';
            link.textContent = 'Görüntüle';
            card.appendChild(link);
          }

          results.appendChild(card);
        });
      }

      input.addEventListener('input', function () {
        var q = input.value.trim();
        clearTimeout(debounceTimer);

        if (q.length < 2) {
          results.innerHTML = '';
          emptyMsg.style.display = 'none';
          hintMsg.style.display = 'block';
          return;
        }

        hintMsg.style.display = 'none';

        debounceTimer = setTimeout(function () {
          fetch('/kisiler/api/ara?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (data) { renderResults(data.results || []); })
            .catch(function () {
              results.innerHTML = '';
              emptyMsg.textContent = 'Arama sırasında bir hata oluştu.';
              emptyMsg.style.display = 'block';
            });
        }, 300);
      });
    })();
  </script>

<%- include('../partials/footer', { t }) %>
