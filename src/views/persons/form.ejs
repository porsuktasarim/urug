<%- include('../partials/header', { title: person && person._id ? t('person.editTitle') : t('person.newTitle'), t }) %>

  <div style="max-width: 560px;">
    <h1 class="h4 mb-4">
      <%= person && person._id ? t('person.editTitle') : t('person.newTitle') %>
    </h1>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <% // familyGroupId form'dan geldiğinde string, DB'den geldiğinde ObjectId/populate objesi olabilir %>
    <% var selectedFamilyId = person && person.familyGroupId
         ? (person.familyGroupId._id ? String(person.familyGroupId._id) : String(person.familyGroupId))
         : ''; %>
    <% var hasNoLastNameChecked = person && (person.hasNoLastName === true || person.hasNoLastName === 'on'); %>

    <%
      // Kişi formundaki TÜM alanların (çekirdek/sistem + admin'in eklediği
      // özel alanlar) sırası artık AttributeDefinition.order üzerinden
      // yönetiliyor (bkz. Kişi Özellikleri admin ekranı). "relationships"
      // (Akrabalık Bağları) HTML kısıtı nedeniyle (form içinde form olamaz)
      // her zaman ana <form> KAPANDIKTAN SONRA ayrıca render ediliyor,
      // sırası ne olursa olsun — geri kalan her şey tam olarak admin'in
      // belirlediği sırayla akıyor.
      var fieldsInForm = formFields.filter(function (f) { return f.key !== 'relationships'; });
      var hasRelationshipsField = formFields.some(function (f) { return f.key === 'relationships'; });
      var currentGroup = null;
    %>

    <form method="POST"
          action="<%= person && person._id ? '/kisiler/' + person._id : '/kisiler' %>">

      <% fieldsInForm.forEach(function (field) { %>
        <% if (field.group !== currentGroup) { %>
          <% currentGroup = field.group; %>
          <h2 class="h6 text-muted mt-4"><%= currentGroup %></h2>
        <% } %>

        <% if (field.isSystem) { %>

          <% if (field.key === 'familyGroupId') { %>
            <div class="mb-3">
              <label class="form-label"><%= t('person.fields.familyGroupId') %></label>
              <select name="familyGroupId" class="form-select">
                <option value="">—</option>
                <% familyGroups.forEach(function (fg) { %>
                  <option value="<%= fg._id %>" <%= selectedFamilyId === String(fg._id) ? 'selected' : '' %>>
                    <%= fg.name %>
                  </option>
                <% }); %>
              </select>
            </div>

          <% } else if (field.key === 'officialFirstName') { %>
            <div class="mb-3">
              <label class="form-label"><%= t('person.fields.officialFirstName') %></label>
              <input type="text" name="officialFirstName" class="form-control" required
                     value="<%= person ? (person.officialFirstName || '') : '' %>">
            </div>

          <% } else if (field.key === 'officialLastName') { %>
            <div class="mb-3">
              <label class="form-label"><%= t('person.fields.officialLastName') %></label>
              <input type="text" name="officialLastName" id="officialLastName" class="form-control"
                     value="<%= person ? (person.officialLastName || '') : '' %>"
                     <%= hasNoLastNameChecked ? 'disabled' : '' %>>
            </div>
            <div class="form-check mb-4">
              <input type="checkbox" name="hasNoLastName" class="form-check-input" id="hasNoLastName"
                     <%= hasNoLastNameChecked ? 'checked' : '' %>
                     onchange="document.getElementById('officialLastName').disabled = this.checked; if (this.checked) document.getElementById('officialLastName').value = '';">
              <label class="form-check-label" for="hasNoLastName"><%= t('person.fields.hasNoLastName') %></label>
            </div>

          <% } else if (field.key === 'birthYear') { %>
            <div class="mb-3">
              <label class="form-label">Doğum Tarihi</label>
              <div class="d-flex gap-2 flex-wrap align-items-end mb-1">
                <div>
                  <label class="form-label small mb-1">Takvim</label>
                  <select name="birthCalendarType" id="birthCalendarType" class="form-select">
                    <option value="miladi" <%= !person || !person.birthCalendarType || person.birthCalendarType === 'miladi' ? 'selected' : '' %>>Miladi</option>
                    <option value="hicri" <%= person && person.birthCalendarType === 'hicri' ? 'selected' : '' %>>Hicri</option>
                    <option value="rumi" <%= person && person.birthCalendarType === 'rumi' ? 'selected' : '' %>>Rumi</option>
                  </select>
                </div>
                <div id="birthDayWrap">
                  <label class="form-label small mb-1">Gün</label>
                  <input type="number" name="birthDay" id="birthDay" class="form-control" style="width:80px;" min="1" max="31"
                         value="<%= person && person.birthDay ? person.birthDay : '' %>">
                </div>
                <div id="birthMonthWrap">
                  <label class="form-label small mb-1">Ay</label>
                  <input type="number" name="birthMonth" id="birthMonth" class="form-control" style="width:80px;" min="1" max="12"
                         value="<%= person && person.birthMonth ? person.birthMonth : '' %>">
                </div>
                <div>
                  <label class="form-label small mb-1" id="birthYearLabel">Yıl</label>
                  <input type="number" name="birthYear" id="birthYear" class="form-control" style="width:100px;"
                         value="<%= person && person.birthCalendarType && person.birthCalendarType !== 'miladi' ? (person.birthOriginalYear || '') : (person && person.birthYear ? person.birthYear : '') %>">
                </div>
              </div>
              <div class="form-text" id="birthConvertedPreview"></div>
            </div>
            <% if (person && person.slug) { %>
              <div class="mb-3">
                <label class="form-label"><%= t('person.fields.slug') %></label>
                <div class="form-control-plaintext text-muted">/<%= person.familyGroupId && person.familyGroupId.slug ? person.familyGroupId.slug : '...' %>/<%= person.slug %></div>
              </div>
            <% } %>

          <% } else if (field.key === 'deathYear') { %>
            <div class="mb-3">
              <label class="form-label">Ölüm Tarihi <span class="text-muted small">(bilinmiyorsa/hayattaysa boş bırak)</span></label>
              <div class="d-flex gap-2 flex-wrap align-items-end mb-1">
                <div>
                  <label class="form-label small mb-1">Takvim</label>
                  <select name="deathCalendarType" id="deathCalendarType" class="form-select">
                    <option value="miladi" <%= !person || !person.deathCalendarType || person.deathCalendarType === 'miladi' ? 'selected' : '' %>>Miladi</option>
                    <option value="hicri" <%= person && person.deathCalendarType === 'hicri' ? 'selected' : '' %>>Hicri</option>
                    <option value="rumi" <%= person && person.deathCalendarType === 'rumi' ? 'selected' : '' %>>Rumi</option>
                  </select>
                </div>
                <div id="deathDayWrap">
                  <label class="form-label small mb-1">Gün</label>
                  <input type="number" name="deathDay" id="deathDay" class="form-control" style="width:80px;" min="1" max="31"
                         value="<%= person && person.deathDay ? person.deathDay : '' %>">
                </div>
                <div id="deathMonthWrap">
                  <label class="form-label small mb-1">Ay</label>
                  <input type="number" name="deathMonth" id="deathMonth" class="form-control" style="width:80px;" min="1" max="12"
                         value="<%= person && person.deathMonth ? person.deathMonth : '' %>">
                </div>
                <div>
                  <label class="form-label small mb-1" id="deathYearLabel">Yıl</label>
                  <input type="number" name="deathYear" id="deathYear" class="form-control" style="width:100px;"
                         value="<%= person && person.deathCalendarType && person.deathCalendarType !== 'miladi' ? (person.deathOriginalYear || '') : (person && person.deathYear ? person.deathYear : '') %>">
                </div>
              </div>
              <div class="form-text" id="deathConvertedPreview"></div>
            </div>

          <% } else if (field.key === 'tcNumber') { %>
            <div class="mb-4">
              <label class="form-label">TC Kimlik No</label>
              <input type="text" name="tcNumber" class="form-control" maxlength="11"
                     placeholder="<%= person && person.tcEncrypted ? 'TC girildi — değiştirmek için yeni numara gir' : 'Girilmedi' %>">
              <div class="form-text">
                Şifreli saklanır, düz metin hiçbir yerde tutulmaz. Boş bırakırsan mevcut değer değişmez.
              </div>
            </div>

          <% } else if (field.key === 'nicknames') { %>
            <div class="mb-3">
              <label class="form-label">Kişisel Lakap(lar) <span class="text-muted small">(virgülle ayırın)</span></label>
              <input type="text" name="personalNicknames" class="form-control"
                     value="<%= typeof personalNicknamesValue !== 'undefined' ? personalNicknamesValue : '' %>"
                     placeholder='örn: Küçük Hüseyin, Topal'>
            </div>
            <div class="mb-3">
              <label class="form-label">Sülale Lakabı <span class="text-muted small">(tek)</span></label>
              <input type="text" name="familyLakab" id="familyLakabInput" class="form-control"
                     value="<%= typeof familyLakabValue !== 'undefined' ? familyLakabValue : '' %>"
                     placeholder="örn: Bayramlılar">
            </div>
            <div class="mb-4">
              <label class="form-label">Sülale Lakabı Kimden Miras <span class="text-muted small">(opsiyonel)</span></label>
              <input type="text" id="lakabInheritedSearch" class="form-control"
                     value="<%= typeof familyLakabInheritedFromName !== 'undefined' ? familyLakabInheritedFromName : '' %>"
                     placeholder="Ad-soyad yazıp aramaya başla" autocomplete="off">
              <input type="hidden" name="familyLakabInheritedFrom" id="lakabInheritedId"
                     value="<%= typeof familyLakabInheritedFromId !== 'undefined' && familyLakabInheritedFromId ? familyLakabInheritedFromId : '' %>">
              <div id="lakabInheritedResults" class="list-group mt-1"></div>
            </div>

          <% } else if (field.key === 'marriedLastNameSection') { %>
            <p class="text-muted small">
              Eş eklendiğinde (cinsiyet "Kadın" işaretliyse) otomatik doldurulur, elle de düzenlenebilir.
            </p>
            <div class="mb-3">
              <label class="form-label">Cinsiyet <span class="text-muted small">(otomasyon için opsiyonel)</span></label>
              <select name="gender" class="form-select">
                <option value="" <%= !person || !person.gender ? 'selected' : '' %>>Belirtilmedi</option>
                <option value="female" <%= person && person.gender === 'female' ? 'selected' : '' %>>Kadın</option>
                <option value="male" <%= person && person.gender === 'male' ? 'selected' : '' %>>Erkek</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Evlilik Soyadı</label>
              <input type="text" name="marriedLastName" class="form-control"
                     value="<%= person && person.marriedLastName ? person.marriedLastName : '' %>">
            </div>
            <div class="form-check mb-4">
              <input type="checkbox" name="useCombinedLastName" class="form-check-input" id="useCombinedLastName"
                     <%= person && person.useCombinedLastName ? 'checked' : '' %>>
              <label class="form-check-label" for="useCombinedLastName">
                Kızlık ve evlilik soyadı birlikte kullanılıyor (parantezsiz göster)
              </label>
            </div>

          <% } %>

        <% } else { %>
          <% // Admin'in eklediği dinamik (isSystem=false) özel alan — tip bazlı render %>
          <% var fieldName = 'attr_' + field.key; %>
          <% var currentValue = attributeValues[field.key]; %>

          <div class="mb-3">
            <label class="form-label">
              <%= field.label %><% if (field.isRequired && !(field.conditionalRequirement && field.conditionalRequirement.dependsOn)) { %> *<% } %>
            </label>

            <% if (field.type === 'text' || field.type === 'number' || field.type === 'date') { %>
              <input type="<%= field.type === 'text' ? 'text' : field.type %>" name="<%= fieldName %>" class="form-control"
                     value="<%= currentValue !== undefined ? currentValue : '' %>">

            <% } else if (field.type === 'textarea') { %>
              <textarea name="<%= fieldName %>" class="form-control" rows="3"><%= currentValue !== undefined ? currentValue : '' %></textarea>

            <% } else if (field.type === 'boolean') { %>
              <div class="form-check">
                <input type="checkbox" name="<%= fieldName %>" class="form-check-input" id="<%= fieldName %>"
                       <%= currentValue === true ? 'checked' : '' %>>
                <label class="form-check-label" for="<%= fieldName %>"><%= field.label %></label>
              </div>

            <% } else if (field.type === 'select') { %>
              <select name="<%= fieldName %>" class="form-select">
                <option value="">—</option>
                <% (field.options || []).forEach(function (opt) { %>
                  <option value="<%= opt %>" <%= currentValue === opt ? 'selected' : '' %>><%= opt %></option>
                <% }); %>
              </select>

            <% } else if (field.type === 'multiselect') { %>
              <% var currentValues = Array.isArray(currentValue) ? currentValue : []; %>
              <% (field.options || []).forEach(function (opt) { %>
                <div class="form-check">
                  <input type="checkbox" name="<%= fieldName %>" value="<%= opt %>" class="form-check-input"
                         id="<%= fieldName %>_<%= opt %>"
                         <%= currentValues.indexOf(opt) !== -1 ? 'checked' : '' %>>
                  <label class="form-check-label" for="<%= fieldName %>_<%= opt %>"><%= opt %></label>
                </div>
              <% }); %>
            <% } %>
          </div>
        <% } %>
      <% }); %>

      <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary"><%= t('common.actions.save') %></button>
        <a href="/kisiler" class="btn btn-outline-secondary"><%= t('common.actions.cancel') %></a>
      </div>
    </form>

    <% if (hasRelationshipsField && person && person._id) { %>
      <hr class="my-4">
      <h2 class="h6 text-muted">Akrabalık Bağları</h2>

      <div class="mb-2">
        <strong>Baba:</strong>
        <% if (typeof father !== 'undefined' && father) { %>
          <%= displayName(father) %>
          <form action="/kisiler/<%= person._id %>/iliski-kaldir/ebeveyn/father" method="POST" class="d-inline"
                onsubmit="return confirm('Baba bağlantısını kaldırmak istediğine emin misin?');">
            <button type="submit" class="btn btn-sm btn-outline-danger ms-2">Kaldır</button>
          </form>
        <% } else { %>
          <span class="text-muted">yok</span>
          <a href="/kisiler/<%= person._id %>/iliski-ekle?type=father" class="btn btn-sm btn-outline-secondary ms-2">Baba Ekle</a>
        <% } %>
      </div>

      <div class="mb-2">
        <strong>Anne:</strong>
        <% if (typeof mother !== 'undefined' && mother) { %>
          <%= displayName(mother) %>
          <form action="/kisiler/<%= person._id %>/iliski-kaldir/ebeveyn/mother" method="POST" class="d-inline"
                onsubmit="return confirm('Anne bağlantısını kaldırmak istediğine emin misin?');">
            <button type="submit" class="btn btn-sm btn-outline-danger ms-2">Kaldır</button>
          </form>
        <% } else { %>
          <span class="text-muted">yok</span>
          <a href="/kisiler/<%= person._id %>/iliski-ekle?type=mother" class="btn btn-sm btn-outline-secondary ms-2">Anne Ekle</a>
        <% } %>
      </div>

      <div class="mb-2">
        <strong>Kardeşler:</strong>
        <% if (typeof siblings !== 'undefined' && siblings.length > 0) { %>
          <ul class="mb-1">
            <% siblings.forEach(function (s) { %>
              <li><%= displayName(s) %><% if (s.birthYear) { %> <span class="text-muted small">(<%= s.birthYear %>)</span><% } %></li>
            <% }); %>
          </ul>
        <% } else { %>
          <span class="text-muted d-block mb-1">yok</span>
        <% } %>
      </div>

      <div class="mb-2">
        <strong>Eş(ler):</strong>
        <% if (typeof spouses !== 'undefined' && spouses.length > 0) { %>
          <ul class="mb-1 list-unstyled">
            <% spouses.forEach(function (s) { %>
              <li class="mb-1">
                <%= displayName(s) %>
                <form action="/kisiler/<%= person._id %>/iliski-kaldir/es/<%= s._id %>" method="POST" class="d-inline"
                      onsubmit="return confirm('Bu eş bağlantısını kaldırmak istediğine emin misin?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger ms-2">Kaldır</button>
                </form>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <span class="text-muted d-block mb-1">yok</span>
        <% } %>
        <a href="/kisiler/<%= person._id %>/iliski-ekle?type=spouse" class="btn btn-sm btn-outline-secondary">Eş Ekle</a>
      </div>

      <div class="mb-2">
        <strong>Çocuklar:</strong>
        <% if (typeof children !== 'undefined' && children.length > 0) { %>
          <ul class="mb-1 list-unstyled">
            <% children.forEach(function (c) { %>
              <% var cLabel = typeof childRelationLabel !== 'undefined' ? childRelationLabel(c) : ''; %>
              <li class="mb-1">
                <%= displayName(c) %>
                <% if (cLabel) { %><span class="text-muted small"> (<%= cLabel %>)</span><% } %>
                <% if (c.birthYear) { %><span class="text-muted small"> · <%= c.birthYear %></span><% } %>
                <form action="/kisiler/<%= person._id %>/iliski-kaldir/cocuk/<%= c._id %>" method="POST" class="d-inline"
                      onsubmit="return confirm('Bu çocuk bağlantısını kaldırmak istediğine emin misin?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger ms-2">Kaldır</button>
                </form>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <span class="text-muted d-block mb-1">yok</span>
        <% } %>
        <a href="/kisiler/<%= person._id %>/iliski-ekle?type=child" class="btn btn-sm btn-outline-secondary">Çocuk Ekle</a>
      </div>
    <% } %>
  </div>

  <script>
    (function () {
      // Hicri/Rumi -> Miladi yaklaşık dönüşüm (utils/calendarConversion.js ile
      // aynı formüller — sadece canlı önizleme için, asıl dönüşüm sunucuda yapılır).
      function hijriToGregorian(y) { return Math.round(y + 622 - y / 33); }
      function rumiToGregorian(y) { return y + 584; }

      function setupDateField(prefix) {
        var calendarSelect = document.getElementById(prefix + 'CalendarType');
        var dayWrap = document.getElementById(prefix + 'DayWrap');
        var monthWrap = document.getElementById(prefix + 'MonthWrap');
        var yearInput = document.getElementById(prefix + 'Year');
        var yearLabel = document.getElementById(prefix + 'YearLabel');
        var preview = document.getElementById(prefix + 'ConvertedPreview');
        if (!calendarSelect) return;

        function update() {
          var type = calendarSelect.value;
          var dayInput = document.getElementById(prefix + 'Day');
          var monthInput = document.getElementById(prefix + 'Month');

          if (type === 'miladi') {
            dayWrap.style.display = '';
            monthWrap.style.display = '';
            dayInput.disabled = false;
            monthInput.disabled = false;
            yearLabel.textContent = 'Yıl';
            preview.textContent = '';
          } else {
            dayWrap.style.display = 'none';
            monthWrap.style.display = 'none';
            dayInput.disabled = true;
            monthInput.disabled = true;
            dayInput.value = '';
            monthInput.value = '';
            yearLabel.textContent = type === 'hicri' ? 'Yıl (Hicri)' : 'Yıl (Rumi)';

            var y = Number(yearInput.value);
            if (yearInput.value && !isNaN(y)) {
              var converted = type === 'hicri' ? hijriToGregorian(y) : rumiToGregorian(y);
              preview.textContent = 'Miladi karşılığı (yaklaşık): ' + converted;
            } else {
              preview.textContent = '';
            }
          }
        }

        calendarSelect.addEventListener('change', update);
        yearInput.addEventListener('input', update);
        update();
      }

      setupDateField('birth');
      setupDateField('death');
    })();
  </script>

  <script>
    (function () {
      var searchInput = document.getElementById('lakabInheritedSearch');
      var hiddenId = document.getElementById('lakabInheritedId');
      var results = document.getElementById('lakabInheritedResults');
      var debounceTimer = null;

      if (!searchInput) return;

      searchInput.addEventListener('input', function () {
        var q = searchInput.value.trim();
        hiddenId.value = ''; // yeniden aramaya başlayınca eski seçim geçersiz sayılır

        clearTimeout(debounceTimer);
        if (q.length < 2) {
          results.innerHTML = '';
          return;
        }

        debounceTimer = setTimeout(function () {
          fetch('/kisiler/api/ara?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (data) {
              results.innerHTML = '';
              (data.results || []).forEach(function (p) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'list-group-item list-group-item-action';
                btn.textContent = p.displayName + (p.birthYear ? ' (' + p.birthYear + ')' : '');
                btn.addEventListener('click', function () {
                  searchInput.value = p.displayName;
                  hiddenId.value = p.id;
                  results.innerHTML = '';
                });
                results.appendChild(btn);
              });
            });
        }, 300);
      });
    })();
  </script>

<%- include('../partials/footer', { t }) %>
