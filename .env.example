# Uygulama
PORT=1207
ACTIVE_LOCALE=tr

# MongoDB
MONGO_URI=mongodb://mongo:27017/urug

# TC kimlik no şifreleme (Adım 11) — 64 hex karakter (32 byte) üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TC_ENCRYPTION_KEY=
# HMAC gizli anahtarı — TC_ENCRYPTION_KEY'den farklı, rastgele uzun bir metin olmalı
TC_HMAC_SECRET=

# Oturum imzalama anahtarı — rastgele uzun bir metin
SESSION_SECRET=

# Profil QR kodlarının tam adres üretebilmesi için (ör. https://secere.aile.com)
# Boş bırakılırsa QR kod göreli path içerir, sadece uygulamanın kendi adresini
# zaten bilen cihazlarda anlamlı olur.
BASE_URL=
